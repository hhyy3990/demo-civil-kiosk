modules = ["nodejs-24", "python-base-3.13"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- --port 5000"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
CIVIL_UNIVERSAL_LAYOUT_V2_CENTRAL_RELAY_ENABLED = "false"
CIVIL_UNIVERSAL_LAYOUT_V2_OPENAI_RELAY_ENABLED = "true"
CIVIL_UNIVERSAL_LAYOUT_CENTRAL_RELAY_ENABLED = "false"
CIVIL_UNIVERSAL_LAYOUT_OPENAI_RELAY_ENABLED = "false"
CIVIL_UNIVERSAL_LAYOUT_V2_LOCAL_FAKE_AUTO_ENABLED = "false"
